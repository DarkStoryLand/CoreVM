# DarkStory LAND Docker stack - copy to docker/.env and fill in (never commit .env)
# Avoid single quotes (') in passwords: they are passed into SQL scripts.

# SQL Server 'sa' password (only used by Docker scripts; can be changed freely)
MSSQL_SA_PASSWORD=

# Password of the GameSrv SQL login used by the game servers and web portal.
# IMPORTANT: the current server .exe files have this password compiled in
# ([CC]ServerModule/DataBase.cpp). Until the servers are rebuilt to read it from
# a config file, this MUST equal the compiled value or the game cannot log in to SQL.
GAMESRV_PASSWORD=

# Supervisord dashboard login (user: admin), reachable only on 127.0.0.1:9001
SUPERVISOR_PASSWORD=

# Optional: override the map server list (space- or comma-separated map numbers).
# Empty = every MapServer in SWorking/ServerSet/1/serverlist.msl.
MAP_SERVER_IDS=

# Optional: pin a different SQL Server image tag
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2019-CU32-GDR12-ubuntu-20.04
